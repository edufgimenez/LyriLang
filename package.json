{
  "name": "lyrilang",
  "version": "0.5.2",
  "private": true,
  "description": "Extensão que mostra a tradução das letras do Spotify Web abaixo da linha original.",
  "scripts": {
    "lint": "web-ext lint",
    "start": "web-ext run --start-url https://open.spotify.com",
    "build": "web-ext build --overwrite-dest"
